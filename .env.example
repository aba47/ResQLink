# ==============================================================================
# DisasterReady / ResQLink Environment Configuration Template (.env.example)
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT!
# Copy this file to .env and configure real production secrets.
# ==============================================================================

# Application Environment & Debugging
# POINT 18: Keep debug mode OFF in production, keep secrets out of logs
APP_ENV=production
APP_DEBUG=false

# Authentication & Cryptographic Keys
# POINT 1 & 5: Server-side JWT Secret. Generate a strong key using:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_64_character_hex_secret_key_generated_via_secrets_module
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin Bootstrap Secret (used ONLY for initial admin creation)
# POINT 9: Protect admin actions even when called directly
ADMIN_BOOTSTRAP_SECRET=replace_with_secure_random_admin_token

# AI Budget & Usage Caps
# POINT 1 & 12: Secret AI API key kept STRICTLY on backend. Quota prevents budget drain.
AI_API_KEY=your_openai_or_gemini_server_side_key_here
AI_DAILY_USER_LIMIT=10
AI_MAX_TOKENS_PER_REQUEST=1000

# Server-Side Payment Verification
# POINT 17: Verify payments on server before unlocking paid features
PAYMENT_GATEWAY_WEBHOOK_SECRET=replace_with_payment_webhook_hmac_secret

# Database & Storage
# POINT 8: Lock down database and private file storage
DATABASE_PATH=backend/disaster_server.db
STORAGE_UPLOAD_DIR=backend/storage/uploads
UPLOAD_MAX_BYTES=5242880

# Rate Limiting
# POINT 11: Rate-limit login, signup, and expensive API calls
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=3
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://10.0.2.2:8000
